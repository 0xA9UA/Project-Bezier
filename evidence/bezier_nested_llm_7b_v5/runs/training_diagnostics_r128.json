  "definitions": {
    "record_selection": "Parse complete JSONL lines, retain phase=reasoning and reasoning_step1..128, require exact contiguous order. Replay updates are excluded.",
    "canonical_record_hash": "SHA256 of UTF-8 json.dumps(value, sort_keys=True, separators=(comma,colon), ensure_ascii=False, allow_nan=False). The window hash uses the ordered array of all128 complete reasoning records; per-record hashes use each record object.",
    "growing_log_note": "No whole-log checksum is used. The first128 reasoning records are canonicalized independently of later appended records.",
    "classes": "Rescue: accuracy delta+1; spoil: delta-1; tie: delta0. Delta is current-weight alternative full-vocabulary greedy correctness minus same-fork Stay correctness.",
    "loss_share": "Sum logged weighted_control_loss_by_class across128 updates; divide each class total by the sum over all classes. Includes control_weight.",
    "logit_gradient_mass_share": "Sum logged weighted_control_logit_gradient_mass_by_class across128 updates; normalize across classes. This is L1 mass of the analytic derivative with respect to returned controller logits, not shared-parameter gradient attribution.",
    "reconstruction": "targets=.5+(.5-label_smoothing)*logged_target_utility; class weights=tie_weight for ties else1. Reconstruct BCE as logaddexp(0,z)-target*z and gradient magnitude as abs(sigmoid(z)-target), multiply by class_weight*control_weight/(B*C).",
    "global_logit_std": "Population standard deviation over every returned controller logit in the128-update window, mixing examples,candidates,and changing weight states.",
    "within_program_candidate_std": "Population standard deviation across the4 counterbalanced examples in one program for one candidate, then mean across128 programs and2 candidates.",
    "centered_auc": "Subtract the per-program/per-candidate mean logit before pooling decisive examples. This removes their common offsets but is still a descriptive TRAIN statistic.",
    "auc": "Mann-Whitney rescue-versus-spoil AUC: probability(rescue_logit>spoil_logit), with0.5 credit for ties; neutral cases excluded. No threshold fitting.",
    "within_program_candidate_auc": "Compute rescue-versus-spoil AUC separately within each program/candidate that contains both classes; report the unweighted mean and qualifying count.",
    "zero_threshold_recombination": "Choose argmax candidate when its logged raw logit>0, otherwise Stay; gather correctness from logged homogeneous fork outcomes. This is CPU diagnostic recombination, not an actual mixed-dispatch deployment evaluation.",
    "all_tie_ratio": "For all-tie programs, logged weighted total control loss divided by unweighted mean BCE. Expected ratio=control_weight*tie_weight=.08.",
    "interpretation_limit": "Models change during each window, program variants/candidates are correlated, and outcome labels differ between arms as weights diverge. These statistics are not fixed-model held-out evidence or confidence intervals."
  },
